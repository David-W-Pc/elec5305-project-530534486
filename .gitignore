# ============================================
# ELEC5305 Non-Speech Sound Recognition Project
# Comprehensive .gitignore for MATLAB + macOS
# ============================================

###############
# 1) DATASETS #
###############

# Entire ESC-50 dataset (DO NOT upload large datasets to GitHub)
data/ESC-50/
ESC-50/
*/ESC-50/

# Ignore all audio files
*.wav
*.mp3
*.flac
*.aiff
*.m4a
*.ogg


#############################
# 2) MATLAB Backup & Cache  #
#############################

# Autosave files
*.asv

# MATLAB temporary files
*.mat
*.mex*

# Simulink autosave
*.mdl.autosave
*.slx.autosave

# MATLAB codegen output folders
codegen/
slprj/


#########################
# 3) macOS System Files #
#########################

.DS_Store
.AppleDouble
.LSOverride
Icon?
._*


#############################
# 4) Logs & Temp Documents #
#############################

*.log
*.tmp
*.bak
*.old


#################################
# 5) Python / VSCode (Optional) #
#################################

__pycache__/
*.pyc
.vscode/
.env
.ipynb_checkpoints/


##################
# 6) Build Files #
##################

/build/
/dist/
*.o
*.obj
*.exe
*.dll


###########################
# 7) Project Result Files #
###########################

results/
output/
plots/
figures/
